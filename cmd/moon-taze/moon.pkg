import {
  "unmbt/moon-taze" @taze,
  "unmbt/cac",
  "unmbt/clack/ansi" @clack_ansi,
  "unmbt/clack/core" @clack_core,
  "unmbt/clack/prompts" @clack_prompts,
  "unmbt/clack/term" @clack_term,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

pkgtype(kind: "executable")

supported_targets = "native"

rule(
  name: "gen_version",
  command: "moon run tools/gen_version.mbtx $input $output",
)

dev_build(
  rule: "gen_version",
  input: "../../moon.mod",
  output: "generated_version.mbt",
)

options(
  "native-stub": [ "terminal_native.c" ],
)
