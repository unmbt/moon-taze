----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/encoding/utf8",
}
----

///|
async fn main {
  let root = @fs.tmpdir(prefix="moon-taze-native-probe")
  defer @fs.remove(root, recursive=true)
  let source = @utf8.encode("probe\n")
  let first = root + "/first.txt"
  let second = root + "/second.txt"
  @fs.write_binary(first, source, sync=@fs.SyncMode::Data)
  let read_back = @fs.read_binary(first)
  @fs.rename(first, second, replace=false)
  let renamed = @fs.exists(second)

  let https = @async.with_timeout_opt(5000, () => {
    @http.get("https://mooncakes.io/api/v0/modules/moonbitlang%2Fmoon_config")
  })
  let https_status = match https {
    None => "timeout"
    Some((response, _)) => "HTTP \{response.code}"
  }

  let process_result = try {
    let result = @process.run(
      "moon",
      ["version"],
      inherit_env=true,
      stdout=Collect,
    )
    "exit=0, stdout=\{result.stdout_text().trim()}"
  } catch {
    error => "error=\{error}"
  }

  let terminal = try {
    ignore(@stdio.stdin.fd())
    "stdin-available=true"
  } catch {
    _ => "stdin-fd=unavailable"
  }
  println("native_probe_root=\{root}")
  println(
    "fs_read=\{@utf8.decode_lossy(read_back).trim()}, atomic_rename=\{renamed}",
  )
  println("https=\{https_status}")
  println("process=\{process_result}")
  println("terminal=\{terminal}")
}
