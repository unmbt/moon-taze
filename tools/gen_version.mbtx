import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  let args = @env.args()
  guard args is [_, input, output] else {
    fail("usage: gen_version.mbtx <moon.mod> <output.mbt>")
  }
  let root = @env.get_env_var("MOON_MANIFEST_ROOT").unwrap_or("../moon-manifest")
  guard @fs.exists(root + "/moon.mod") else {
    fail("moon-manifest module not found: " + root)
  }
  @shell.Cmd(
    "moon",
    [
      "-C", root, "run", "--target", "native", "cmd/moon-manifest",
      "generate-version", @fs.realpath(input), @fs.realpath(".") + "/" + output,
      "VERSION",
    ],
  ).run()
}
